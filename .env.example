# 复制为 .env 后填写；包导入时自动加载，已存在的同名环境变量优先。
# DeepSeek 官方示例：LLM_MODEL=deepseek/deepseek-flash + LLM_API_KEY=sk-xxx
LLM_MODEL=
LLM_MODEL_COMPILER=
LLM_MODEL_STRONG=
LLM_MODEL_NPC=
LLM_MODEL_JUDGE=
LLM_MODEL_SIMULATOR=
LLM_MODEL_GUARD=
LLM_API_KEY=
LLM_BASE_URL=
LLM_TEMPERATURE=0.3
NPC_GENERATION_MODE=grounded
API_TOKEN=
AUTHOR_TOKEN=
CONTEXT_MODE=full
# PostgreSQL 连接串（必需）；GAME_DB 是旧变量名，同样接受连接串
PG_DSN=postgresql://user:password@127.0.0.1:5432/jubensha
GAME_DB=
SCRIPT_FIXTURE=fixtures/wugang_01.json
